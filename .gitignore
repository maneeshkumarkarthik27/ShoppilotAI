*.pyc

# Environment secrets
.env

# Media Cache (Ignore all audio and bill formats)
static/audio_cache/*.ogg
static/audio_cache/*.mp3
static/audio_cache/*.wav
static/audio_cache/*.m4a

static/sample_bills/*.jpg
static/sample_bills/*.jpeg
static/sample_bills/*.png
